{
  "name": "jaehan-blog",
  "description": "Jae han's dev blog by Remix v2",
  "private": true,
  "sideEffects": true,
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@9.15.0",
  "keywords": [
    "remix",
    "dev",
    "blog",
    "송재한",
    "jae han",
    "wisesaturn"
