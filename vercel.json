{
  "redirects": [
    {
      "source": "/all",
      "destination": "/posts",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/react",
      "destination": "/posts?category=react",
      "permanent": true
    },
    {
      "source": "/nextjs",
      "destination": "/posts?category=nextjs",
      "permanent": true
    },
    {
      "source": "/frontend",
      "destination": "/posts?category=frontend",
      "permanent": true
    },
    {
      "source": "/typescript",
      "destination": "/posts?category=typescript",
      "permanent": true
    },
    {
      "source": "/react/:path*",
      "destination": "/posts/react/:path*",
      "permanent": true
    },
    {
      "source": "/nextjs/:path*",
      "destination": "/posts/nextjs/:path*",
      "permanent": true
    },
    {
      "source": "/frontend/:path*",
      "destination": "/posts/frontend/:path*",
      "permanent": true
    },
    {
      "source": "/typescript/:path*",
      "destination": "/posts/typescript/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "Content-Type",
          "value": "text/html"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, stale-while-revalidate=31556952"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, stale-while-revalidate=31556952"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, stale-while-revalidate=31556952"
        }
      ]
    },
    {
      "source": "/:path*\\.(css|js|svg|jpg|png|gif|webp|ico|woff2|woff|ttf|eot|webmanifest)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31556952, s-maxage=31556952, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1;mode=block"
        }
      ]
    }
  ]
}
